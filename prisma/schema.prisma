// Lockin — schema.
// Note: SQLite does not support Prisma enums. Every field commented "enum" is a
// String constrained by a TypeScript union in lib/types.ts. Keep the two in sync.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id        String    @id @default(cuid())
  code      String    @unique
  title     String
  examDate  DateTime?
  weighting Float? // share of the final grade riding on the exam, 0-1
  createdAt DateTime  @default(now())

  lectures  Lecture[]
  modules   Module[]
  concepts  Concept[]
  materials Material[]
  papers    PastPaper[]
}

/// A course's own division of its content — "Module 3: Gene expression". Optional,
/// because not every course publishes one, and a lecture that fits nowhere should
/// still be importable rather than forced into an invented bucket.
model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@unique([courseId, title])
  @@index([courseId])
}

model Lecture {
  id            String   @id @default(cuid())
  courseId      String
  moduleId      String?
  title         String
  deliveredOn   DateTime // weekday is derived from this, never stored
  durationHours Float    @default(1) // x2 = default question count
  summaryMd     String?
  /// True while the title is a placeholder made from a filename. The first AI pass
  /// (or a pasted summary with a heading) replaces it; editing it by hand clears this.
  autoTitle     Boolean  @default(false)
  /// JSON [{ what, where, about?, added? }]: module aims, learning objectives and admin
  /// that were left out of the summary and questions, so the omission is visible, not
  /// silent. `about` says what the part contained; `added` is set once the student has
  /// put it back into the summary.
  skipped       String?
  /// JSON [{ slide, notes }]: what each slide shows — its words, including any inside
  /// pictures, and what its figures depict — from a model that saw the slides. The
  /// steps that only read text (writing LAQs) use these instead of the extracted text.
  slideNotes    String?
  /// Who wrote the summary, for display: "Claude Code · claude-sonnet-…", "Offline ·
  /// Gemma 4 E4B", "Pasted from an AI chat". Null for summaries from before this was kept.
  summaryModel  String?
  createdAt     DateTime @default(now())

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  materials Material[]
  concepts  Concept[]
  questions Question[]
  attempts  Attempt[]
  jobs      Job[]
  glossary  GlossaryTerm[]
  flashcards Flashcard[]
  mcqs       Mcq[]

  @@index([courseId])
  @@index([moduleId])
}

/// A phrase the student picked out of a lecture's summary, with the short explanation
/// they chose to keep. Underlined wherever it appears in that summary; hovering it
/// shows the explanation.
model GlossaryTerm {
  id          String   @id @default(cuid())
  lectureId   String
  term        String
  explanation String
  createdAt   DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model Material {
  id            String   @id @default(cuid())
  courseId      String?
  lectureId     String?
  kind          String // enum: TRANSCRIPT | SLIDES | FIGURE | PAST_PAPER | RECORDING
  path          String // relative to materials/; the DB never stores blobs
  originalName  String
  extractedText String? // parsed once at ingest, hand-correctable
  /// Pages or slides in a deck, including those with no text; null for other files.
  pageCount     Int?
  checksum      String
  /// A recording's length in seconds, once its sound has been read.
  durationSec   Float?
  /// Set on a transcript made from a recording: the recording's id.
  sourceId      String?
  /// How a transcript was made from a recording: "Gemini · gemini-2.5-flash",
  /// "Whisper large-v3 turbo, checked by Claude Code · sonnet".
  madeBy        String?
  createdAt     DateTime @default(now())

  course  Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture Lecture?    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  papers  PastPaper[]

  @@index([lectureId])
  @@index([courseId])
}

/// The load-bearing table. Course-scoped, not lecture-scoped, so extraction can
/// reuse an existing concept instead of minting a near-duplicate.
model Concept {
  id           String   @id @default(cuid())
  courseId     String
  lectureId    String? // where it was first introduced
  name         String
  definition   String
  sourceRef    String? // slide number or transcript timestamp
  mergedIntoId String? // set by the merge tool; excluded from all scoring
  createdAt    DateTime @default(now())

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture    Lecture?           @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  questions  QuestionConcept[]
  gaps       Gap[]
  reviews    Review[]
  paperItems PaperItemConcept[]

  @@index([courseId])
  @@index([lectureId])
}

model Question {
  id            String   @id @default(cuid())
  lectureId     String
  stem          String
  type          String // enum: LAQ | SAQ
  rubric        String // JSON: model answer + mark allocation, frozen at generation
  promptVersion String
  /// Who wrote it, for display, as Lecture.summaryModel.
  model         String?
  createdAt     DateTime @default(now())
  /// Set on a question from a past paper (the PaperItem's id). Those are asked only
  /// when the paper is sat, never in the lecture's own sittings or mixed exams.
  paperItemId   String?
  /// Set on a question that spans several related lectures: JSON array of every
  /// lecture's id, this one (`lectureId`, where its answers are filed) first. Asked in
  /// exams only, never in one lecture's sittings.
  linkedLectureIds String?

  lecture   Lecture           @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  concepts  QuestionConcept[]
  responses Response[]
  examItems ExamItem[]

  @@index([lectureId])
  @@index([paperItemId])
}

model QuestionConcept {
  questionId String
  conceptId  String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
}

model Attempt {
  id            String    @id @default(cuid())
  lectureId     String
  sittingDate   DateTime  @default(now())
  closedBook    Boolean   @default(true)
  geometricMean Float? // null until every response is marked
  completedAt   DateTime?
  source        String    @default("APP") // enum: APP | PASTED (scores pasted from an AI chat) | EXAM (LAQs from an exam)

  lecture   Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([lectureId])
}

model Response {
  id             String    @id @default(cuid())
  attemptId      String
  questionId     String
  answerText     String
  /// What has been typed so far, saved as it is typed, until the sitting is submitted.
  draftText      String?
  mark           Float? // 0-10
  rubricVersion  String?
  rawMarkingJson String?
  markedAt       DateTime?
  /// When the student said they'd copied this answer's notes sheet (what was wrong and
  /// missed) into their own notes. Null until then.
  notesCopiedAt  DateTime?

  attempt   Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gaps      Gap[]
  examItems ExamItem[]

  @@index([attemptId])
  @@index([questionId])
}

/// This table is the loose-leaf binder. Every row is tagged to a concept, which
/// is what turns "did I miss this again?" into a GROUP BY.
model Gap {
  id         String   @id @default(cuid())
  responseId String
  conceptId  String
  type       String // enum: MISSED | WRONG
  text       String
  createdAt  DateTime @default(now())

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId])
  @@index([responseId])
}

model Review {
  id             String    @id @default(cuid())
  conceptId      String
  dueOn          DateTime
  intervalDays   Float
  setByAttemptId String?
  completedAt    DateTime?

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId])
  @@index([dueOn])
}

model PastPaper {
  id         String   @id @default(cuid())
  courseId   String
  year       Int
  label      String? // "Semester 1", "Deferred", etc.
  materialId String?
  createdAt  DateTime @default(now())

  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  material Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  items    PaperItem[]

  @@index([courseId])
}

model PaperItem {
  id              String  @id @default(cuid())
  paperId         String
  stem            String
  marksAllocated  Float?
  questionNumber  String?

  paper    PastPaper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  concepts PaperItemConcept[]

  @@index([paperId])
}

model PaperItemConcept {
  paperItemId String
  conceptId   String

  paperItem PaperItem @relation(fields: [paperItemId], references: [id], onDelete: Cascade)
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([paperItemId, conceptId])
  @@index([conceptId])
}

model Job {
  id            String    @id @default(cuid())
  kind          String // enum: PREPARE | GENERATE | MARK | DOWNLOAD | SORT | ASK | FLASHCARDS | MCQS
  payload       String // JSON
  /// The lecture this work is for, so "what is it doing right now" is a lookup
  /// rather than a search through payloads. Deleting the lecture drops its jobs.
  lectureId     String?
  status        String    @default("PENDING") // enum: PENDING | RUNNING | DONE | FAILED
  /// Higher runs first. Marking jumps the queue: someone is waiting on it.
  priority      Int       @default(0)
  /// What the job is doing right now, e.g. "digest" or "questions".
  stage         String?
  /// JSON [{ stage, startedAt, finishedAt }] — the timeline the UI shows.
  steps         String?
  attempts      Int       @default(0)
  error         String?
  result        String? // raw model output, kept so a bad mark is always traceable
  promptVersion String?
  /// The model that did the work, for display, as Lecture.summaryModel.
  model         String?
  durationMs    Int?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  lecture Lecture? @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([lectureId])
}

/// App-wide preferences and the worker's heartbeat. Key/value, values are JSON.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// AK scheduling is independent of concept/LAQ reviews. Content is never regenerated
// over existing cards, so a retry cannot erase someone's review history.
model Flashcard {
  id           String   @id @default(cuid())
  lectureId    String
  front        String
  back         String
  sourceKey    String
  model        String?
  promptVersion String?
  state        String   @default("new")
  dueAt        DateTime @default(now())
  intervalDays Float    @default(0)
  ease         Float    @default(2.5)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  /// Where the card came from: "ai" (a generated deck), "manual" (written by the
  /// student), "csv" (imported), "anki" (an Anki package), "occlusion" (cover-up boxes
  /// on a picture) or "mistake" (something missed or got wrong in a marked answer).
  origin       String   @default("ai")
  /// Left out of reviews until unsuspended.
  suspended    Boolean  @default(false)
  /// Space-separated tags, padded with a space each side (" renal drugs ") so one tag
  /// can be matched whole; "" when there are none.
  tags         String   @default("")
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  reviews      FlashcardReview[]

  @@unique([lectureId, sourceKey])
  @@index([lectureId, dueAt])
  @@index([state, dueAt])
}

model FlashcardReview {
  id         String   @id @default(cuid())
  cardId     String
  version    Int
  rating     Int
  reviewedAt DateTime @default(now())
  dueAt      DateTime
  card       Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, version])
  @@index([reviewedAt])
}

/// Multiple-choice questions, written with a lecture's LAQs and kept out of sight until
/// exam mode: one best answer among four or five.
model Mcq {
  id            String   @id @default(cuid())
  lectureId     String
  stem          String
  /// JSON array of the options, in the order shown.
  options       String
  /// Index into options of the correct one.
  answer        Int
  explanation   String
  /// The concept it tests, when it maps to one on the lecture's list.
  conceptId     String?
  promptVersion String
  model         String?
  createdAt     DateTime @default(now())

  lecture   Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  examItems ExamItem[]

  @@index([lectureId])
}

/// A practice exam across lectures: LAQs and MCQs from the lectures chosen.
model Exam {
  id           String    @id @default(cuid())
  courseId     String?
  title        String
  /// JSON { courseId, lectureIds } — what it was drawn from.
  scope        String
  /// Minutes allowed; null for no limit.
  timeLimitMin Int?
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?

  items ExamItem[]

  @@index([createdAt])
}

model ExamItem {
  id         String  @id @default(cuid())
  examId     String
  position   Int
  kind       String // enum: MCQ | LAQ
  mcqId      String?
  /// The option chosen, for an MCQ.
  choice     Int?
  questionId String?
  /// What has been typed for an LAQ, until the exam is handed in.
  draftText  String?
  /// The LAQ's answer once handed in: marked like any other.
  responseId String?

  exam     Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  mcq      Mcq?      @relation(fields: [mcqId], references: [id], onDelete: SetNull)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  response Response? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([examId])
}
