DATABASE_URL="file:./prisma/lockin.db"
# Path to the standalone CLI. The desktop app ships a copy that is not on PATH.
LOCKIN_CLAUDE_BIN="claude"
# Which Claude does the work is chosen in Settings (Sonnet unless you pick another).
# LOCKIN_EFFORT sets how hard it thinks when preparing and marking: low, medium (the
# default), high, xhigh or max — or "default" to leave it to Claude Code.
# "cli" runs Claude Code. "fake" returns canned output after a short delay, for
# trying the app or working on the UI without making model calls.
LOCKIN_PROVIDER="cli"
